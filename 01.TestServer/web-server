FROM tomcat:9.0.60-jre11-openjdk-slim-buster

USER root
RUN sed -i 's|http://deb.debian.org/debian|http://archive.debian.org/debian|g' /etc/apt/sources.list \
	&& sed -i 's|http://security.debian.org/debian-security|http://archive.debian.org/debian-security|g' /etc/apt/sources.list \
	&& printf 'Acquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99no-check-valid \
	&& apt-get update \
	&& apt-get install -y --no-install-recommends openssh-server \
	&& rm -rf /var/lib/apt/lists/*

COPY web-server-entrypoint.sh /usr/local/bin/web-server-entrypoint.sh
RUN chmod +x /usr/local/bin/web-server-entrypoint.sh

EXPOSE 22
ENTRYPOINT ["/usr/local/bin/web-server-entrypoint.sh"]